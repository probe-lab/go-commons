# Variables the integration tests read. Without them the tests skip.
# go-commons is a library: the variables of a tool built on it start with its own prefix.

# PostgreSQL integration tests (db/pg_migrations_test.go)
GO_COMMONS_TEST_POSTGRES_DSN=

# ClickHouse integration tests (db/ch_migrations_test.go)
GO_COMMONS_TEST_CLICKHOUSE_ADDR=
GO_COMMONS_TEST_CLICKHOUSE_USER=
GO_COMMONS_TEST_CLICKHOUSE_PASSWORD=
GO_COMMONS_TEST_CLICKHOUSE_DATABASE=
